---
source: shepherd-search/src/backend/postgres.rs
assertion_line: 594
expression: "build_hits(&p, 2000, &columns()).into_string()"
---
SELECT h.doc_id, h.score, h.sort_key::text AS sort_key, c.filename, c."amount"::text AS "col_amount", c."received_at" AS "col_received_at", c."status" AS "col_status", c.facets, c.schemas, c.created_at, c.updated_at, ts_headline('english', left(c.content, 100000), h.tsq, 'MaxFragments=2, MaxWords=30, MinWords=10, StartSel=, StopSel=') AS highlight, ARRAY(SELECT p.page_no FROM search.pages p WHERE p.doc_id = h.doc_id AND p.tsv @@ h.tsq ORDER BY p.page_no LIMIT 20) AS matched_pages FROM (SELECT c.doc_id, (ts_rank_cd(c.tsv, q.query, 32) + 0.1::real * similarity(COALESCE(c.filename, ''), q.text)) AS score, (ts_rank_cd(c.tsv, q.query, 32) + 0.1::real * similarity(COALESCE(c.filename, ''), q.text)) AS sort_key, q.query AS tsq FROM (SELECT c.doc_id, c.tsv, c.filename FROM search.cards c CROSS JOIN (SELECT websearch_to_tsquery('english', $1) AS query, $2::text AS text) AS q WHERE TRUE AND (c.tsv @@ q.query OR c.filename % q.text OR c.doc_id = ANY(ARRAY(SELECT p.doc_id FROM search.pages p WHERE NOT p.in_card AND p.tsv @@ q.query LIMIT 100000))) AND c."status" = $3::text AND c.facets && $4::text[] AND c."status" = ANY($5::text[]) AND c."amount" >= $6::numeric AND c."amount" < $7::numeric AND c.fields @> $8 AND c.facets @> ARRAY[$9]::text[] ORDER BY c.updated_at DESC, c.doc_id DESC LIMIT 2000) c CROSS JOIN (SELECT websearch_to_tsquery('english', $10) AS query, $11::text AS text) AS q WHERE TRUE AND ((ts_rank_cd(c.tsv, q.query, 32) + 0.1::real * similarity(COALESCE(c.filename, ''), q.text)), c.doc_id) < ($12::real, $13) ORDER BY (ts_rank_cd(c.tsv, q.query, 32) + 0.1::real * similarity(COALESCE(c.filename, ''), q.text)) DESC, c.doc_id DESC LIMIT 21) h JOIN search.cards c ON c.doc_id = h.doc_id ORDER BY h.sort_key DESC, h.doc_id DESC
