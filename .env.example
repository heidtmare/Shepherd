# Copy to .env to override docker-compose defaults.
POSTGRES_PASSWORD=postgres
S3_ACCESS_KEY=shepherd
S3_SECRET_KEY=shepherd-dev-secret
SEARCH_ADMIN_TOKEN=dev-admin-token
STREAM_ADMIN_TOKEN=dev-admin-token
RUST_LOG=info,sqlx=warn
# shepherd-notification outbound mail; defaults to the mailpit container.
SMTP_URL=smtp://mailpit:1025
EMAIL_FROM=Shepherd Notices <notices@shepherd.invalid>
